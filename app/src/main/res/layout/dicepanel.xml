<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dice Roll"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginTop="4dp"/>

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Roll the dice and test your luck!"-->
<!--            android:textSize="16sp"-->
<!--            android:textColor="#777777"-->
<!--            android:layout_marginTop="4dp"/>-->


        <!-- Number of Dice Label -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Player"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginTop="25dp"/>


        <!-- Dropdown -->

        <Spinner
            android:id="@+id/diceSpinnerPlayer"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Dice"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginTop="25dp"/>


        <!-- Dropdown -->

        <Spinner
            android:id="@+id/diceSpinnerDice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp" />


        <!-- Dice Card -->

        <LinearLayout
            android:id="@+id/playerSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:layout_marginTop="25dp"
            android:padding="20dp"
            android:orientation="vertical">


            <!-- Dynamic Dice Grid -->

        </LinearLayout>


        <!-- Roll Button -->

        <Button
            android:id="@+id/goButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Go"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>



    </LinearLayout>

</ScrollView>